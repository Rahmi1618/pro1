# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret Key
JWT_SECRET=pharmacare_secret_key_2024_change_in_production

# Database Configuration
DB_PATH=./pharmacare.db

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# Logging
LOG_LEVEL=info

# Security
BCRYPT_ROUNDS=10