# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret Key (Change this in production!)
JWT_SECRET=pharmacare_secret_key_2024_change_in_production

# Database Configuration
DB_PATH=./pharmacare.db

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Payment Integration (TeleBirr, etc.)
TELEBIRR_API_URL=https://api.telebirr.et
TELEBIRR_MERCHANT_ID=your-merchant-id
TELEBIRR_API_KEY=your-api-key

# File Upload Configuration
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif

# Security
BCRYPT_ROUNDS=10
SESSION_SECRET=your-session-secret

# External APIs
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
WEATHER_API_KEY=your-weather-api-key